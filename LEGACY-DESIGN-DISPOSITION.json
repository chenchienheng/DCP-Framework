{
  "schema": "xuanling.legacy-design-disposition.v1",
  "status": "ARCHITECTURE_CANDIDATE",
  "runtime": false,
  "promotion": false,
  "purpose": "Prevent retired repository generations from regaining Current eligibility while preserving lineage, reusable primitives, failure memory, and rebuild paths, and allow gated reclaim when historical bodies no longer carry unique value or live dependency.",
  "current_entry": "CURRENT-SURFACE-MANIFEST.json",
  "current_projection_candidate": "SIX_DIMENSION_REPOSITORY_PROJECTION.md",
  "lineage_index": "REPOSITORY_CORPUS_INDEX.md",
  "rules": {
    "historical_searchable_is_current": false,
    "root_presence_is_current": false,
    "old_master_label_is_authority": false,
    "merge_to_main_is_admission": false,
    "tool_name_is_architecture_invariant": false,
    "old_register_reference_recreates_artifact": false,
    "physical_delete_required_for_metabolism": false,
    "historical_retention_required_forever": false,
    "explicit_reentry_required": true,
    "reclaim_requires_gate": true,
    "legacy_name_must_survive_as_live_filename": false,
    "historical_role_name_may_be_retained_inside_lineage_body": true
  },
  "naming_metabolism_gate": {
    "purpose": "Prevent retired ontology names from remaining on high-visibility reader/navigation surfaces after their semantics have been absorbed.",
    "classify": [
      "KEEP_CANONICAL_TERM",
      "HISTORICAL_TERM_IN_BODY_ONLY",
      "RENAME_TO_NEUTRAL_SUCCESSOR",
      "MERGE_ALIAS_INTO_SUCCESSOR",
      "RETIRE_FILENAME_TO_GIT_HISTORY",
      "HOLD_IF_EXTERNAL_POINTER_UNKNOWN"
    ],
    "rename_when": [
      "legacy term encodes a retired role/topology/tool binding",
      "file remains discoverable on root or normal navigation surface",
      "successor semantics are already complete",
      "unique lineage can remain in Git history or a neutral specimen"
    ],
    "do_not_rename_when": [
      "term is still a valid domain concept",
      "external or legal pointer stability requires the exact path",
      "successor coverage is incomplete",
      "rename would destroy unique evidence or unresolved lineage"
    ],
    "completed_examples": {
      "MOTHER_TREE_CLEARANCE_REPORT.md": "HISTORICAL_REVIEW_DECISION_SPECIMEN.md",
      "CLOUDTOP_RELAY_CHANNEL_SPEC.md": "LEGACY_CARRIER_RELAY_SPECIMEN.md"
    }
  },
  "reclaim_gate": {
    "required": [
      "successor coverage complete",
      "unique evidence retained or proven absent",
      "failure specimen retained when material",
      "lineage/provenance retained at minimal sufficient level",
      "no active reader/routing/wake caller",
      "no rebuild dependency",
      "no legal/retention hold"
    ],
    "result_before_delete": "RECLAIM_ELIGIBLE_CANDIDATE",
    "destructive_delete_requires_separate_authorized_action": true
  },
  "families": [
    {
      "id": "LEGACY-REGISTER-GENERATION",
      "artifacts": ["UNIFIED_ARTIFACT_REGISTER.md", "CLEANUP_QUEUE_REGISTER.md", "GITHUB_CHAIN_MASTER_MAP.md"],
      "disposition": "HISTORICAL_REFERENCE",
      "retain_primitives": ["inventory", "lineage", "cleanup classification", "naming-drift detection", "continuity mapping"],
      "successor": ["CURRENT-SURFACE-MANIFEST.json", "REPOSITORY_CORPUS_INDEX.md", "LEGACY-DESIGN-DISPOSITION.json"],
      "reentry_requires": ["exact source", "material need", "authority", "evidence", "successor compatibility"]
    },
    {
      "id": "LEGACY-LIFECYCLE-WINDOW-GENERATION",
      "artifacts": ["00_meta/FULL_LIFECYCLE_ASSET_MATRIX.md", "01_runtime-spine", "01_native-board", "02_runtime-ops"],
      "disposition": "HISTORICAL_SPECIMEN",
      "retain_primitives": ["stable artifact ID", "lifecycle tracking", "hardening gate", "return path", "archive lineage", "blocker/state/permission concepts"],
      "retire_assumptions": ["S1-S5 is universal lifecycle", "W0/Wx are stable ontology", "merge to main means Active", "repository registry means receiver absorption"],
      "successor": ["SIX_DIMENSION_REPOSITORY_PROJECTION.md", "CURRENT-SURFACE-MANIFEST.json"]
    },
    {
      "id": "LEGACY-FIXED-AGENT-CLOUD-GENERATION",
      "artifacts": ["02_translation-layer/CLOUD_OVER_CLOUD_CONTROL_CENTER_SPEC.md", "04_adapter-layer", "LEGACY_CARRIER_RELAY_SPECIMEN.md"],
      "disposition": "HISTORICAL_SPECIMEN",
      "retain_primitives": ["capture", "evidence classification", "semantic translation", "adapter/writeback", "packet contract", "failure return route"],
      "retire_assumptions": ["Gemini is always Scout", "Jules is always Semantic Bridge", "Codex is always Repo Bridge", "vendor/model name defines authority", "fixed four-stage relay is universal", "CloudTop is a stable control-center ontology"],
      "successor": ["SIX_DIMENSION_REPOSITORY_PROJECTION.md", "DCP_LIFECYCLE_DEPENDENCY_KERNEL.md"]
    },
    {
      "id": "LEGACY-AXIS-MASTER-GENERATION",
      "artifacts": ["CORETRI_MASTER_CONSOLIDATION_REVIEW.md", "WORLD_CHAIN_MASTER_AXIS.md", "TIME_CHAIN_MASTER_LAYER.md", "SPACE_CHAIN_MASTER_LAYER.md", "REVIEW_CHAIN_MASTER_LAYER.md", "00_mother-law", "HISTORICAL_REVIEW_DECISION_SPECIMEN.md"],
      "disposition": "HISTORICAL_OR_BOUNDED_REUSE",
      "retain_primitives": ["world relation", "time relation", "space relation", "review relation", "existence continuity", "external handoff", "semantic review vs hygiene separation"],
      "retire_assumptions": ["AXIS label establishes Current", "Master label establishes authority", "phase snapshot establishes present maturity", "one historical routing axis must govern every future external input", "MotherTree role-name establishes review authority"],
      "successor": ["CURRENT-SURFACE-MANIFEST.json", "SIX_DIMENSION_REPOSITORY_PROJECTION.md", "DCP_LIFECYCLE_DEPENDENCY_KERNEL.md"],
      "reentry_requires": ["primitive-level materiality", "current evidence", "bounded receiver", "no second authority"]
    },
    {
      "id": "LEGACY-ROOT-FAMILIES",
      "artifacts": ["00_meta", "00_mother-law", "01_native-board", "01_runtime-spine", "02_runtime-ops", "02_translation-layer", "03_board-orchestration", "03_field-governance", "04_adapter-layer", "04_interface-layer", "05_XLEN_Reserve_Unenabled", "05_topology"],
      "disposition": "HISTORICAL_OR_COMPATIBILITY_UNLESS_EXPLICITLY_RE_ADMITTED",
      "reader_rule": "Do not traverse by default. Read only through an exact historical, audit, conflict, missing-lineage, or re-entry need.",
      "physical_reclaim": "GATED_CANDIDATE_ALLOWED",
      "reclaim_rule": "Apply reclaim_gate per affected body; historical placement or family membership alone neither requires permanent retention nor authorizes deletion."
    }
  ],
  "six_dimension_interpretation": {
    "domain": "Native owner/world remains outside repository placement",
    "authority": "Repository visibility or push permission does not grant semantic approval/release/ACK authority",
    "state": "Historical/Current/Candidate/Return/Reconciled must be explicit",
    "circle": "Issue/PR/window/project context is bounded and temporary",
    "pole": "DCP is projection weight, not repository sovereignty",
    "cloud": "GitHub is the carrier binding"
  },
  "metabolism_complete_when": [
    "successor exists or historical purpose is explicit",
    "reader shield prevents silent Current reuse",
    "retained primitives are separated from retired assumptions",
    "re-entry conditions are named",
    "no unresolved reference forces recreation of retired architecture",
    "historical body has an explicit retain/reclaim disposition rather than indefinite accidental persistence",
    "retired ontology names no longer dominate normal reader/navigation surfaces when neutral successor naming is available"
  ]
}
